# Copy this file to .env and fill in your own values.
# Never commit the .env file.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: leave DB_ENGINE as sqlite3 to use SQLite.
# For MySQL use django.db.backends.mysql; for PostgreSQL use django.db.backends.postgresql
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
